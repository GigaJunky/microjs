data/touchcal.json

# flash backups of other firmware: never publish these
backup/
*.bak
# built images: attach them to a GitHub release instead
release/*.bin
release/*.FLH
release/*.zip
# personal archives
*.zip

# Node tools (npm install)
node_modules/
release/*.uf2
